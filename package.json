        "@sveltejs/adapter-cloudflare": "^8.0.0",
        "@sveltejs/kit": "^3.0.0",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^26.6.4",
        "@vitest/coverage-v8": "^5.0.2",
        "eslint": "^10.12.0",
        "eslint-plugin-svelte": "^3.23.0",
        "fast-check": "^4.10.2",
        "globals": "^17.13.0",
        "happy-dom": "^20.14.5",
        "jsdom": "^30.1.2",
        "prettier": "^3.9.9",
        "prettier-plugin-svelte": "^4.1.1",
        "svelte": "^5.57.1",
        "svelte-check": "^4.7.6",
        "tailwindcss": "^4.3.3",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.0",
        "vite": "^8.3.2",
        "vitest": "^5.0.3",
        "wrangler": "^4.147.0"
